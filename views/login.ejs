<!DOCTYPE html>
<html lang="en">
<head>
  <title>Admin Login - Hostel Finder</title>
  <style>
    body {
      margin: 0;
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: #f9fafb; /* Light off-white base */
      height: 100vh;
      display: flex;
      justify-content: center;
      align-items: center;
    }
/* ================= MAP BACKGROUND PATTERN ================= */
    body::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('/image/map.png');
      background-size: cover;
      background-position: center;
      opacity: 0.5;
      z-index: -1;
      pointer-events: none;
    }
    
    /* MAIN SPLIT-SCREEN CONTAINER */
    .container {
      display: flex;
      width: 900px;
      height: 550px;
      background: #ffffff;
      border-radius: 20px;
      box-shadow: 0 10px 40px rgba(0,0,0,0.06);
      overflow: hidden;
    }

    /* LEFT SIDE - MAP PICTURE ONLY */
    .map-section {
      flex: 1;
      /* Background image is set inline in the HTML below */
      background-color: #e5e7eb; /* Fallback color */
      background-size: cover;
      background-position: center;
      /* Top ko arch/curved shape dene ke liye */
      border-radius: 200px 200px 0 0;
      margin: 20px;
    }

    /* RIGHT SIDE - LOGIN FORM */
    .form-section {
      flex: 1;
      padding: 50px 60px;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .brand {
      font-size: 16px;
      font-weight: 600;
      color: #111827;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .form-section h2 {
      font-size: 32px;
      color: #111827;
      margin: 0 0 8px 0;
      line-height: 1.2;
    }

    .form-section p {
      color: #6b7280;
      font-size: 14px;
      margin-bottom: 35px;
    }

    /* INPUTS */
    .form-group {
      margin-bottom: 18px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-size: 13px;
      color: #374151;
      margin-bottom: 6px;
      font-weight: 500;
    }

    .form-group input {
      width: 100%;
      padding: 12px 14px;
      border: none;
      background-color: #f3f4f6;
      border-radius: 8px;
      outline: none;
      font-size: 14px;
      box-sizing: border-box;
      transition: 0.3s;
    }

    .form-group input:focus {
      background-color: #e5e7eb;
      box-shadow: 0 0 0 2px rgba(85, 107, 47, 0.2);
    }

    /* BUTTON */
    button {
      width: 100%;
      padding: 14px;
      background-color: #556b2f; /* Olive Green color */
      border: none;
      color: white;
      font-size: 15px;
      font-weight: 600;
      border-radius: 8px;
      cursor: pointer;
      margin-top: 10px;
      transition: 0.3s;
    }

    button:hover {
      background-color: #435525;
    }

    /* SMALL TEXT */
    .note {
      margin-top: 25px;
      font-size: 12px;
      color: #9ca3af;
      text-align: center;
    }
  </style>
</head>
<body>

  <div class="container">
    
    <!-- LEFT SIDE: Sirf Map ki picture (URL change karein) -->
    <div class="map-section" style="background-image: url(/image/images.jpg);"></div>

    <!-- RIGHT SIDE: Admin Login Form -->
    <div class="form-section">
      
      <div class="brand">
        🏠 Hostel Finder
      </div>

      <h2>Welcome Back!</h2>
      <p>Manage and explore with ease</p>

      <!-- Aapki Original Form Functionality -->
      <form method="POST" action="/login">
        
        <div class="form-group">
          <label>Username</label>
          <input type="text" name="username" placeholder="Your username" required />
        </div>

        <div class="form-group">
          <label>Password</label>
          <input type="password" name="password" placeholder="••••••••" required />
        </div>

        <button type="submit">Log In</button>

      </form>

      <div class="note">
        Secure Admin Access Only
      </div>

    </div>
  </div>

</body>
</html>