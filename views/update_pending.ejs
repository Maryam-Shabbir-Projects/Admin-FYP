<!DOCTYPE html>
<html lang="en">
<head>
  <title>Update Requests - Admin Dashboard</title>

  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;

      /* Theme Colors */
      --purple: #8b5cf6;
      --purple-light: #ede9fe;
      --green: #10b981;
      --green-light: #d1fae5;
      --blue: #3b82f6;
      --blue-light: #dbeafe;
      --danger: #ef4444;
      --danger-light: #fee2e2;
      --gray: #94a3b8;
      
      --header-bg: #1e2330;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      position: relative;
      min-height: 100vh;
      padding-bottom: 40px;
    }

    /* ================= MAP BACKGROUND ================= */
    body::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('/image/map.png');
      background-size: cover;
      background-position: center;
      opacity: 0.5;
      z-index: -1;
      pointer-events: none;
    }

    /* ================= NAVBAR ================= */
    .top-navbar {
      background-color: var(--header-bg);
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 30px;
      font-size: 15px;
      font-weight: bold;
      margin-bottom: 30px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge-dark {
      background: rgba(255,255,255,0.1);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: normal;
      color: #cbd5e1;
    }

    .header-btn {
      background: rgba(255,255,255,0.15);
      color: white;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      transition: 0.2s;
      border: 1px solid rgba(255,255,255,0.2);
    }
    
    .header-btn:hover {
      background: rgba(255,255,255,0.25);
    }

    /* ================= CONTAINER ================= */
    .container {
      width: 96%;
      max-width: 1400px;
      margin: auto;
      padding: 0 20px;
    }

    .page-header {
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .page-header h1 {
      font-size: 24px;
      margin-bottom: 5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 14px;
    }

    .total-badge {
      background: var(--purple);
      color: white;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 13px;
      font-weight: bold;
    }

    /* ================= GRID & CARDS ================= */
    .hostels-grid {
      display: grid;
      /* Wider grid column to accommodate the side-by-side comparison */
      grid-template-columns: repeat(auto-fill, minmax(450px, 1fr));
      gap: 20px;
    }

    .hostel-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .hostel-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .hostel-badges {
      display: flex;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .badge-status {
      background: var(--purple-light);
      color: var(--purple);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .badge-id {
      background: #f1f5f9;
      color: #475569;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .hostel-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 15px;
      color: var(--text-main);
    }

    /* ================= COMPARISON SECTION ================= */
    .comparison-container {
      display: flex;
      gap: 15px;
      margin-bottom: 20px;
      flex: 1;
    }

    .comp-box {
      flex: 1;
      padding: 15px;
      border-radius: 10px;
      background: var(--bg-color);
      border: 1px solid var(--border-color);
    }

    .comp-box.current {
      border-left: 4px solid var(--gray);
    }

    .comp-box.requested {
      border-left: 4px solid var(--purple);
      background: #f9f8ff;
    }

    .comp-title {
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .comp-box.current .comp-title { color: var(--gray); }
    .comp-box.requested .comp-title { color: var(--purple); }

    .info-item {
      font-size: 13px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }

    .info-item strong {
      color: var(--text-main);
    }

    .info-item .changed {
      color: var(--purple);
      font-weight: bold;
    }

    /* ================= BUTTONS ================= */
    .actions {
      display: flex;
      gap: 10px;
      margin-top: auto;
    }

    .btn {
      flex: 1;
      text-align: center;
      padding: 10px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
      cursor: pointer;
      border: 1px solid transparent;
    }

    .btn-view {
      background: var(--blue-light);
      color: var(--blue);
      border-color: var(--blue-light);
    }
    .btn-view:hover { background: var(--blue); color: white; }

    .btn-approve {
      background: var(--green-light);
      color: var(--green);
      border-color: var(--green-light);
    }
    .btn-approve:hover { background: var(--green); color: white; }

    .btn-reject {
      background: var(--danger-light);
      color: var(--danger);
      border-color: var(--danger-light);
    }
    .btn-reject:hover { background: var(--danger); color: white; }

    /* ================= EMPTY STATE ================= */
    .empty-state {
      grid-column: 1 / -1;
      background: var(--card-bg);
      padding: 50px 20px;
      text-align: center;
      border-radius: 12px;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      font-size: 15px;
    }

    /* ================= MOBILE ================= */
    @media (max-width: 768px) {
      .hostels-grid {
        grid-template-columns: 1fr;
      }
      .comparison-container {
        flex-direction: column;
      }
      .actions {
        flex-wrap: wrap;
      }
      .btn {
        flex: 1 1 100%;
      }
      .page-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
      }
    }
  </style>
</head>

<body>

  <!-- ================= NAVBAR ================= -->
  <div class="top-navbar">
    <div class="brand-section">
       🏢 Admin Dashboard
      <span class="badge-dark">Update Requests</span>
    </div>
    <a href="/dashboard" class="header-btn">← Back to Dashboard</a>
  </div>

  <!-- ================= MAIN CONTAINER ================= -->
  <div class="container">
    
    <div class="page-header">
      <div>
        <h1>🟣 Update Requests</h1>
        <p>Review and approve modified residence nodes.</p>
      </div>
      <div class="total-badge">
        Total Pending: <%= updatePendingHostels ? updatePendingHostels.length : 0 %>
      </div>
    </div>

    <div class="hostels-grid">
      
      <!-- ================= CHECK UPDATE REQUESTS ================= -->
      <% if (updatePendingHostels && updatePendingHostels.length > 0) { %>
        
        <!-- ================= LOOP ================= -->
        <% updatePendingHostels.forEach(h => { %>
          
          <div class="hostel-card">
            
            <div class="hostel-badges">
              <span class="badge-status">⏳ Update Pending</span>
              <span class="badge-id">ID: <%= h.id %></span>
            </div>

            <div class="hostel-title">
              <%= (h.pendingUpdate && h.pendingUpdate.name) || h.name || "Unnamed Hostel" %>
            </div>

            <!-- COMPARISON SECTION -->
            <div class="comparison-container">

              <!-- CURRENT DATA -->
              <div class="comp-box current">
                <div class="comp-title">Current Info</div>
                
                <div class="info-item">
                  🏢 Name: <strong><%= h.name || "Not specified" %></strong>
                </div>
                
                <div class="info-item">
                  💰 Rent: <strong>Rs <%= h.rent || 0 %></strong>
                </div>
                
                <div class="info-item">
                  👥 Category: <strong><%= h.category || "Not specified" %></strong>
                </div>
                
                <% if (h.whatsapp) { %>
                  <div class="info-item">
                    📱 WhatsApp: <strong><%= h.whatsapp %></strong>
                  </div>
                <% } %>
              </div>

              <!-- REQUESTED DATA -->
              <div class="comp-box requested">
                <div class="comp-title">Requested Changes</div>
                
                <% if (h.pendingUpdate) { %>
                  
                  <div class="info-item">
                    🏢 Name: 
                    <strong class="changed"><%= h.pendingUpdate.name || h.name || "Not specified" %></strong>
                  </div>
                  
                  <div class="info-item">
                    💰 Rent: 
                    <strong class="changed">Rs <%= h.pendingUpdate.rent ?? h.rent ?? 0 %></strong>
                  </div>
                  
                  <div class="info-item">
                    👥 Category: 
                    <strong class="changed"><%= h.pendingUpdate.category || h.category || "Not specified" %></strong>
                  </div>
                  
                  <% if (h.pendingUpdate.whatsapp) { %>
                    <div class="info-item">
                      📱 WhatsApp: 
                      <strong class="changed"><%= h.pendingUpdate.whatsapp %></strong>
                    </div>
                  <% } %>
                  
                  <% if (h.pendingUpdate.location) { %>
                    <div class="info-item">
                      📍 Location: 
                      <strong class="changed"><%= h.pendingUpdate.location %></strong>
                    </div>
                  <% } %>

                <% } else { %>
                  <div class="info-item">No requested changes found.</div>
                <% } %>
              </div>

            </div>

            <!-- ACTIONS -->
            <div class="actions">
              <a href="/hostel/<%= h.id %>" class="btn btn-view">👁 View</a>
              
              <a href="/approve-edit/<%= h.id %>" class="btn btn-approve" onclick="return confirm('Are you sure you want to approve these changes?');">
                ✓ Approve
              </a>
              
              <a href="/reject-edit/<%= h.id %>" class="btn btn-reject" onclick="return confirm('Are you sure you want to reject these changes?');">
                ✕ Reject
              </a>
            </div>

          </div>

        <% }) %>
        
      <% } else { %>
        
        <!-- ================= EMPTY STATE ================= -->
        <div class="empty-state">
          📝 <strong>No Update Requests</strong><br><br>
          There are currently no hostel update requests waiting for approval.
        </div>
        
      <% } %>

    </div>

  </div>

</body>
</html>