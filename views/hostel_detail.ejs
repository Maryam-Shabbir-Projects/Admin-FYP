<!DOCTYPE html>
<html lang="en">
<head>
  <title>Hostel Details - Admin Dashboard</title>

  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;

      /* Theme Colors */
      --orange: #ea580c;
      --orange-light: #ffedd5;
      --green: #10b981;
      --green-light: #d1fae5;
      --blue: #3b82f6;
      --blue-light: #dbeafe;
      --pink: #ec4899;
      --pink-light: #fce7f3;
      --purple: #8b5cf6;
      --purple-light: #ede9fe;
      --red: #ef4444;
      --red-light: #fee2e2;
      
      --header-bg: #1e2330;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      position: relative;
      min-height: 100vh;
      padding-bottom: 40px;
    }

    /* ================= MAP BACKGROUND PATTERN ================= */
    body::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('/image/map.png');
      background-size: cover;
      background-position: center;
      opacity: 0.5;
      z-index: -1;
      pointer-events: none;
    }

    /* ================= TOP NAVBAR ================= */
    .top-navbar {
      background-color: var(--header-bg);
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 30px;
      font-size: 15px;
      font-weight: bold;
      margin-bottom: 30px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge-dark {
      background: rgba(255,255,255,0.1);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: normal;
      color: #cbd5e1;
    }

    /* HEADER BACK BUTTON */
    .header-btn {
      background: rgba(255,255,255,0.15);
      color: white;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      transition: 0.2s;
      border: 1px solid rgba(255,255,255,0.2);
    }
    
    .header-btn:hover {
      background: rgba(255,255,255,0.25);
    }

    /* ================= FULL SCREEN CONTAINER ================= */
    .container {
      width: 96%;
      max-width: 1600px;
      margin: auto;
      padding: 0 20px;
    }

    /* ================= CARDS WITH HOVER EFFECT ================= */
    .card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 25px;
      margin-bottom: 25px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .title {
      font-size: 24px;
      font-weight: bold;
      color: var(--text-main);
      margin-bottom: 12px;
    }

    /* ================= BADGES ================= */
    .badge {
      display: inline-block;
      padding: 5px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      margin-right: 8px;
      margin-bottom: 15px;
    }

    .badge.boys { background: var(--blue-light); color: var(--blue); }
    .badge.girls { background: var(--pink-light); color: var(--pink); }
    .badge.approved { background: var(--green-light); color: var(--green); }
    .badge.update { background: var(--purple-light); color: var(--purple); }
    .badge.pending { background: var(--orange-light); color: var(--orange); }

    /* ================= SECTION TITLES ================= */
    .section-title {
      margin-top: 15px;
      margin-bottom: 15px;
      font-size: 16px;
      font-weight: bold;
      color: var(--text-main);
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 8px;
    }

    /* ================= GRID & INFO BOXES (HOVER) ================= */
    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
      gap: 15px;
      margin-bottom: 20px;
    }

    .info-box {
      background: var(--bg-color);
      padding: 15px;
      border-radius: 8px;
      border: 1px solid transparent;
      transition: all 0.2s ease;
    }

    .info-box:hover {
      background: var(--card-bg);
      border-color: #cbd5e1;
      box-shadow: 0 4px 10px rgba(0,0,0,0.03);
      transform: translateY(-2px);
    }

    .info-box .label {
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      font-weight: 600;
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 6px;
    }

    .info-box .value {
      color: var(--text-main);
      font-weight: bold;
      font-size: 15px;
    }

    /* ================= SVG ICONS ================= */
    .icon {
      width: 16px;
      height: 16px;
      stroke-width: 2;
      stroke-linecap: round;
      stroke-linejoin: round;
      fill: none;
    }
    
    /* Icon Colors */
    .icon-rent { stroke: var(--orange); }
    .icon-whatsapp { stroke: var(--green); }
    .icon-email { stroke: var(--blue); }
    .icon-category { stroke: var(--purple); }
    .icon-location { stroke: var(--red); }

    /* ================= PENDING EDITS STYLE ================= */
    .info-box.new {
      border-left: 4px solid var(--purple);
      background: var(--purple-light);
    }
    .info-box.new .value { color: var(--purple); }

    /* ================= FACILITIES ================= */
    .facility {
      display: inline-block;
      padding: 6px 14px;
      margin: 4px 4px 4px 0;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      background: var(--bg-color);
      color: var(--text-muted);
      border: 1px solid var(--border-color);
    }

    .facility.active {
      background: var(--green-light);
      color: var(--green);
      border-color: var(--green-light);
    }

    /* ================= IMAGES ================= */
    .images-container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 15px;
      margin-top: 15px;
    }

    .image-box {
      background: var(--bg-color);
      border-radius: 10px;
      overflow: hidden;
      border: 1px solid var(--border-color);
    }

    .hostel-image {
      width: 100%;
      height: 250px;
      object-fit: cover;
      display: block;
      cursor: pointer;
      transition: 0.3s;
    }

    .hostel-image:hover {
      transform: scale(1.05);
    }

    .image-number {
      padding: 10px;
      text-align: center;
      font-size: 12px;
      font-weight: 600;
      color: var(--text-muted);
    }

    .no-data {
      background: var(--bg-color);
      border-radius: 8px;
      padding: 20px;
      text-align: center;
      color: var(--text-muted);
      font-size: 14px;
      border: 1px dashed #cbd5e1;
    }

    /* ================= MAP IFRAME ================= */
    iframe {
      width: 100%;
      height: 400px;
      border: 1px solid var(--border-color);
      border-radius: 10px;
    }

    /* ================= ACTION BUTTONS ================= */
    .actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: center;
    }

    .btn {
      padding: 12px 20px;
      border-radius: 8px;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      transition: 0.2s;
      border: none;
      cursor: pointer;
      display: inline-block;
    }

    .approve-btn { background: var(--green); color: white; }
    .approve-btn:hover { background: #059669; transform: translateY(-2px); }

    .reject-btn { background: var(--red); color: white; }
    .reject-btn:hover { background: #dc2626; transform: translateY(-2px); }

  </style>
</head>

<body>

  <!-- ================= TOP NAVBAR ================= -->
  <div class="top-navbar">
    <div class="brand-section">
      🏢 Admin Dashboard
      <span class="badge-dark">Hostel Details Preview</span>
    </div>
    <!-- BACK BUTTON MOVED HERE -->
    <a href="/dashboard" class="header-btn">← Back to Dashboard</a>
  </div>

  <div class="container">

    <!-- ================= MAIN HOSTEL INFO CARD ================= -->
    <div class="card">

      <div class="title">
        <%= hostel.name || "Unnamed Hostel" %>
      </div>

      <!-- CATEGORY BADGE -->
      <span class="badge <%= hostel.category && hostel.category.toLowerCase().includes('girl') ? 'girls' : 'boys' %>">
        <%= hostel.category || "Category Not Specified" %>
      </span>

      <!-- STATUS BADGE -->
      <% if (hostel.status === "approved") { %>
        <span class="badge approved">Approved</span>
      <% } else if (hostel.status === "update_pending") { %>
        <span class="badge update">Update Pending</span>
      <% } else { %>
        <span class="badge pending"><%= hostel.status || "Pending" %></span>
      <% } %>

      <!-- CURRENT DATA -->
      <div class="section-title">Current Hostel Information</div>

      <div class="grid">
        <div class="info-box">
          <span class="label">
            <svg class="icon icon-rent" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
            Rent
          </span>
          <span class="value">Rs <%= hostel.rent || 0 %></span>
        </div>

        <div class="info-box">
          <span class="label">
            <svg class="icon icon-whatsapp" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            WhatsApp
          </span>
          <span class="value"><%= hostel.whatsapp || "Not provided" %></span>
        </div>

        <div class="info-box">
          <span class="label">
            <svg class="icon icon-email" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            Email
          </span>
          <span class="value"><%= hostel.email || "Not provided" %></span>
        </div>

        <div class="info-box">
          <span class="label">
            <svg class="icon icon-category" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
            Category
          </span>
          <span class="value"><%= hostel.category || "Not specified" %></span>
        </div>

        <div class="info-box">
          <span class="label">
            <svg class="icon icon-location" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Latitude
          </span>
          <span class="value"><%= hostel.latitude || "Not provided" %></span>
        </div>

        <div class="info-box">
          <span class="label">
            <svg class="icon icon-location" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            Longitude
          </span>
          <span class="value"><%= hostel.longitude || "Not provided" %></span>
        </div>
      </div>

      <!-- FACILITIES -->
      <div class="section-title">Facilities</div>

      <% if (hostel.facilities && typeof hostel.facilities === "object" && Object.keys(hostel.facilities).length > 0) { %>
        <div>
          <% Object.keys(hostel.facilities).forEach(key => { %>
            <span class="facility <%= hostel.facilities[key] ? 'active' : '' %>">
              <%= key %>
            </span>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-data">No facilities provided.</div>
      <% } %>

      <!-- HOSTEL IMAGES -->
      <div class="section-title">Hostel Images</div>

      <% if (Array.isArray(hostel.images) && hostel.images.length > 0) { %>
        <div class="images-container">
          <% hostel.images.forEach((image, index) => { %>
            <div class="image-box">
              <img 
                src="<%= image %>" 
                alt="Image <%= index + 1 %>" 
                class="hostel-image" 
                onclick="window.open('<%= image %>', '_blank')" 
                onerror="this.parentElement.style.display='none';"
              >
              <div class="image-number">Image <%= index + 1 %></div>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="no-data">No hostel images available.</div>
      <% } %>

      <!-- PENDING UPDATE SECTION -->
      <% if (hostel.pendingUpdate) { %>
        
        <div class="section-title">Pending Edit Request</div>

        <div class="grid">
          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-rent" viewBox="0 0 24 24"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2"/><path d="M6 12h.01M18 12h.01"/></svg>
              New Rent
            </span>
            <span class="value">Rs <%= hostel.pendingUpdate.rent || "-" %></span>
          </div>

          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-whatsapp" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              New WhatsApp
            </span>
            <span class="value"><%= hostel.pendingUpdate.whatsapp || "-" %></span>
          </div>

          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-email" viewBox="0 0 24 24"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              New Email
            </span>
            <span class="value"><%= hostel.pendingUpdate.email || "-" %></span>
          </div>

          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-category" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
              New Category
            </span>
            <span class="value"><%= hostel.pendingUpdate.category || "-" %></span>
          </div>

          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-location" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              New Latitude
            </span>
            <span class="value"><%= hostel.pendingUpdate.latitude || "-" %></span>
          </div>

          <div class="info-box new">
            <span class="label">
              <svg class="icon icon-location" viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              New Longitude
            </span>
            <span class="value"><%= hostel.pendingUpdate.longitude || "-" %></span>
          </div>
        </div>

        <div class="section-title">New Facilities</div>

        <% if (hostel.pendingUpdate.facilities && typeof hostel.pendingUpdate.facilities === "object") { %>
          <div>
            <% Object.keys(hostel.pendingUpdate.facilities).forEach(key => { %>
              <span class="facility <%= hostel.pendingUpdate.facilities[key] ? 'active' : '' %>">
                <%= key %>
              </span>
            <% }) %>
          </div>
        <% } else { %>
          <div class="no-data">No facility changes requested.</div>
        <% } %>

      <% } %>

    </div>

    <!-- ================= LOCATION MAP CARD ================= -->
    <div class="card">
      <div class="section-title" style="margin-top: 0;">Hostel Location</div>

      <% if (hostel.latitude && hostel.longitude && Number(hostel.latitude) !== 0 && Number(hostel.longitude) !== 0) { %>
        <iframe 
          src="https://www.openstreetmap.org/export/embed.html?bbox=<%= Number(hostel.longitude) - 0.01 %>,<%= Number(hostel.latitude) - 0.01 %>,<%= Number(hostel.longitude) + 0.01 %>,<%= Number(hostel.latitude) + 0.01 %>&layer=mapnik&marker=<%= hostel.latitude %>,<%= hostel.longitude %>">
        </iframe>
      <% } else { %>
        <div class="no-data">Hostel location coordinates are not available.</div>
      <% } %>
    </div>

    <!-- ================= ACTION BUTTONS CARD ================= -->
    <% if (hostel.status !== "approved") { %>
    <div class="card actions">
      
        <% if (hostel.status === "update_pending") { %>
          <a href="/approve-edit/<%= hostel.id %>" class="btn approve-btn" onclick="return confirm('Are you sure you want to approve these changes?');">Approve Changes</a>
          <a href="/reject-edit/<%= hostel.id %>" class="btn reject-btn" onclick="return confirm('Are you sure you want to reject these changes?');">Reject Changes</a>
        <% } else { %>
          <a href="/approve/<%= hostel.id %>" class="btn approve-btn" onclick="return confirm('Are you sure you want to approve this hostel?');">Approve Hostel</a>
          <a href="/reject/<%= hostel.id %>" class="btn reject-btn" onclick="return confirm('Are you sure you want to reject this hostel?');">Reject Hostel</a>
        <% } %>

    </div>
    <% } %>

  </div>

</body>
</html>