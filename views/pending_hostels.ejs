<!DOCTYPE html>
<html lang="en">
<head>
  <title>Pending Hostels - Admin Dashboard</title>

  <style>
    :root {
      --bg-color: #f8fafc;
      --card-bg: #ffffff;
      --text-main: #1e293b;
      --text-muted: #64748b;
      --border-color: #e2e8f0;

      /* Theme Colors */
      --orange: #ea580c;
      --orange-light: #ffedd5;
      --green: #10b981;
      --green-light: #d1fae5;
      --blue: #3b82f6;
      --blue-light: #dbeafe;
      --pink: #ec4899;
      --pink-light: #fce7f3;
      --red: #ef4444;
      --red-light: #fee2e2;
      
      --header-bg: #1e2330;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-main);
      position: relative;
      min-height: 100vh;
      padding-bottom: 40px;
    }

    /* ================= MAP BACKGROUND PATTERN ================= */
    body::before {
      content: "";
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background-image: url('/image/map.png');
      background-size: cover;
      background-position: center;
      opacity: 0.5;
      z-index: -1;
      pointer-events: none;
    }

    /* ================= TOP NAVBAR ================= */
    .top-navbar {
      background-color: var(--header-bg);
      color: white;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 15px 30px;
      font-size: 15px;
      font-weight: bold;
      margin-bottom: 30px;
    }

    .brand-section {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .badge-dark {
      background: rgba(255,255,255,0.1);
      padding: 4px 10px;
      border-radius: 6px;
      font-size: 12px;
      font-weight: normal;
      color: #cbd5e1;
    }

    .header-btn {
      background: rgba(255,255,255,0.15);
      color: white;
      text-decoration: none;
      padding: 8px 16px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 600;
      transition: 0.2s;
      border: 1px solid rgba(255,255,255,0.2);
    }
    
    .header-btn:hover {
      background: rgba(255,255,255,0.25);
    }

    /* ================= MAIN CONTAINER ================= */
    .container {
      width: 96%;
      max-width: 1400px;
      margin: auto;
      padding: 0 20px;
    }

    .page-header {
      margin-bottom: 25px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
    }

    .page-header h1 {
      font-size: 24px;
      margin-bottom: 5px;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .page-header p {
      color: var(--text-muted);
      font-size: 14px;
    }

    /* ================= HOSTELS GRID ================= */
    .hostels-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
    }

    .hostel-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.02);
      display: flex;
      flex-direction: column;
      transition: transform 0.2s, box-shadow 0.2s;
    }

    .hostel-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 10px 20px rgba(0,0,0,0.05);
    }

    .hostel-badges {
      display: flex;
      justify-content: space-between;
      margin-bottom: 15px;
    }

    .badge-status {
      background: var(--orange-light);
      color: var(--orange);
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .badge-category {
      background: #f1f5f9;
      color: #475569;
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      font-weight: 600;
    }

    .badge-category.girls {
      background: var(--pink-light);
      color: var(--pink);
    }

    .badge-category.boys {
      background: var(--blue-light);
      color: var(--blue);
    }

    .hostel-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 15px;
      color: var(--text-main);
    }

    .rent-box {
      background: var(--bg-color);
      border-radius: 8px;
      padding: 15px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
    }

    .rent-box .label {
      color: var(--text-muted);
      font-size: 13px;
      font-weight: 600;
    }

    .rent-box .amount {
      font-size: 16px;
      font-weight: bold;
      color: var(--text-main);
    }

    /* ================= BUTTONS ================= */
    .btn-group {
      display: flex;
      gap: 10px;
      margin-top: auto;
    }

    .btn {
      text-align: center;
      flex: 1;
      padding: 10px;
      border-radius: 8px;
      font-size: 13px;
      font-weight: 600;
      text-decoration: none;
      transition: 0.2s;
      cursor: pointer;
      border: none;
    }

    .btn-view {
      background: var(--bg-color);
      color: var(--text-main);
      border: 1px solid var(--border-color);
    }

    .btn-view:hover {
      background: #e2e8f0;
    }

    .btn-approve {
      background: var(--green);
      color: white;
    }

    .btn-approve:hover {
      background: #059669;
    }

    .empty-state {
      grid-column: 1 / -1;
      background: var(--card-bg);
      padding: 50px 20px;
      text-align: center;
      border-radius: 12px;
      color: var(--text-muted);
      border: 1px solid var(--border-color);
      font-size: 15px;
    }
  </style>
</head>

<body>

  <!-- ================= TOP NAVBAR ================= -->
  <div class="top-navbar">
    <div class="brand-section">
      🏢  Admin Dashboard
      <span class="badge-dark">Pending Approvals</span>
    </div>
    <a href="/dashboard" class="header-btn">← Back to Dashboard</a>
  </div>

  <div class="container">
    
    <div class="page-header">
      <div>
        <h1>🟠 Pending Hostels</h1>
        <p>Review and approve new hostel registration requests.</p>
      </div>
    </div>

    <div class="hostels-grid">
      
      <!-- ================= CHECK PENDING HOSTELS ================= -->
      <% if (pendingHostels && pendingHostels.length > 0) { %>
        
        <!-- ================= LOOP ================= -->
        <% pendingHostels.forEach(h => { %>
          
          <div class="hostel-card">
            
            <div class="hostel-badges">
              <span class="badge-status">Awaiting Audit</span>
              
              <!-- Category Badge with Color Condition -->
              <span class="badge-category 
                <% if (h.category && h.category.toLowerCase().includes('girl')) { %> girls 
                <% } else if (h.category && h.category.toLowerCase().includes('boy')) { %> boys 
                <% } %>">
                <%= h.category || "Not specified" %>
              </span>
            </div>

            <div class="hostel-title">
              <%= h.name || "Unnamed Hostel" %>
            </div>

            <div class="rent-box">
              <span class="label">Rent</span>
              <span class="amount">Rs <%= h.rent || 0 %></span>
            </div>

            <div class="btn-group">
              <a href="/hostel-detail/<%= h.id %>" class="btn btn-view">View Details</a>
              <a href="/approve/<%= h.id %>" class="btn btn-approve" onclick="return confirm('Are you sure you want to approve this hostel?');">Approve</a>
            </div>

          </div>

        <% }) %>
        
      <% } else { %>
        
        <!-- ================= EMPTY STATE ================= -->
        <div class="empty-state">
          🎉 No pending requests. You are all caught up!
        </div>
        
      <% } %>

    </div>

  </div>

</body>
</html>